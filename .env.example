# MongoDB connection string (local or Atlas)
# Local:  mongodb://127.0.0.1:27017/tradeverify
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradeverify?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tradeverify

# Secret used to sign JWT session tokens — generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret

# Name of the httpOnly session cookie
AUTH_COOKIE_NAME=tradeverify_session
